rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function hasValidDisplayName() {
      return request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0;
    }

    function isKeepingSameDisplayName() {
      return request.resource.data.displayName == resource.data.displayName;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && hasValidDisplayName();
      allow get: if signedIn();
      allow list: if signedIn();
      allow update: if signedIn() &&
        (request.auth.uid == userId || isAdmin()) &&
        (isKeepingSameDisplayName() || hasValidDisplayName());
      allow delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /predictions/{predictionId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /referrals/{referralId} {
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.referrerUserId == request.auth.uid &&
        request.resource.data.referredPhoneNumber is string &&
        request.resource.data.referredPhoneNumber.size() > 0;
      allow update: if signedIn() &&
        (
          isAdmin() ||
          resource.data.referrerUserId == request.auth.uid ||
          request.resource.data.referredUserId == request.auth.uid
        );
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if signedIn();
      allow create: if signedIn() || isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /app_settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /weekly_spin_results/{resultId} {
      allow get: if signedIn() &&
        (
          !exists(/databases/$(database)/documents/weekly_spin_results/$(resultId)) ||
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );
      allow list: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /weekly_spin_campaigns/{campaignId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /user_rewards/{rewardId} {
      allow get: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /bonus_grants/{grantId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /user_notifications/{notificationId} {
      allow get: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if signedIn() &&
        (
          isAdmin() ||
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.title == resource.data.title &&
            request.resource.data.message == resource.data.message &&
            request.resource.data.reason == resource.data.reason &&
            request.resource.data.points == resource.data.points &&
            request.resource.data.coins == resource.data.coins &&
            request.resource.data.bonusGrantId == resource.data.bonusGrantId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.seen == true
          )
        );
    }

    match /settlement_snapshots/{snapshotId} {
      allow read, create, update, delete: if isAdmin();

      match /{document=**} {
        allow read, create, update, delete: if isAdmin();
      }
    }

  }
}
