rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function hasValidDisplayName() {
      return request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0;
    }

    function isKeepingSameDisplayName() {
      return request.resource.data.displayName == resource.data.displayName;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && hasValidDisplayName();
      allow get: if signedIn();
      allow list: if signedIn();
      allow update: if signedIn() &&
        (request.auth.uid == userId || isAdmin()) &&
        (isKeepingSameDisplayName() || hasValidDisplayName());
      allow delete: if false;

      match /devices/{deviceId} {
        allow get, list, create, update, delete: if signedIn() &&
          (request.auth.uid == userId || isAdmin());
      }
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /predictions/{predictionId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /referrals/{referralId} {
      allow read: if signedIn();
      allow list: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.referrerUserId == request.auth.uid &&
        request.resource.data.referredPhoneNumber is string &&
        request.resource.data.referredPhoneNumber.size() > 0;
      allow update: if signedIn() &&
        (
          isAdmin() ||
          resource.data.referrerUserId == request.auth.uid ||
          request.resource.data.referredUserId == request.auth.uid
        );
      allow delete: if false;
    }

    match /broadcastNotifications/{broadcastId} {
      allow read: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.type in ["important_update", "maintenance_notice"] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.audience == "all_users" &&
        request.resource.data.status == "queued";
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if signedIn();
      allow create: if signedIn() || isAdmin();
      allow update, delete: if false;
    }
  }
}
